

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Anime{
  id String @id @default(cuid()) @map("_id")
  name String?
  image String?
  address String?
  mobile Int?

  createAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}